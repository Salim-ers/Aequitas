# ─────────────────────────────────────────────────────────────────────────────
# Aequitas — Variables d'environnement
#
# §59 — Ces valeurs se saisissent dans Vercel › Settings › Environment Variables.
# Ce fichier ne sert que de référence : ne le remplissez pas et ne le commitez
# jamais rempli. Aucun secret ne doit atteindre GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données ──────────────────────────────────────────────────────────
# Injectée automatiquement par l'intégration Neon du Vercel Marketplace.
DATABASE_URL=

# ── Authentification ─────────────────────────────────────────────────────────
# 32 caractères minimum. Génération : openssl rand -base64 32
AUTH_SECRET=
# URL canonique de l'environnement. Laissez vide sur Vercel : déduite de VERCEL_URL.
APP_URL=
# Exiger la vérification d'email avant connexion (true en production).
REQUIRE_EMAIL_VERIFICATION=false

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Identifiants de prix Stripe (un par offre et par périodicité).
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ESSENTIAL_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# Durée d'essai en jours, et délai de grâce après échec de paiement.
TRIAL_DAYS=14
BILLING_GRACE_PERIOD_DAYS=7

# ── Stockage ─────────────────────────────────────────────────────────────────
# Injecté automatiquement par l'intégration Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# ── Emails transactionnels ───────────────────────────────────────────────────
EMAIL_API_KEY=
EMAIL_FROM=

# ── Tâches planifiées ────────────────────────────────────────────────────────
# Jeton partagé vérifié par les handlers /api/cron/*.
CRON_SECRET=

# ── Données de démonstration ─────────────────────────────────────────────────
# §62 — Jamais true sur l'environnement de production.
DEMO_SEED_ENABLED=false
